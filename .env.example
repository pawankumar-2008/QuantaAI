# Set DATABASE_URL or all four NEON_DB_* values. DATABASE_URL takes precedence.
DATABASE_URL=

# Neon PostgreSQL connection settings. Replace these placeholders locally.
NEON_DB_HOST=your-neon-host.neon.tech
NEON_DB_NAME=your-database-name
NEON_DB_USERNAME=your-username
NEON_DB_PASSWORD=

# Authentication cookie settings
APP_ENV=development
# Optional override: AUTH_COOKIE_SECURE=true

# OpenRouter powers teacher-mode responses.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_SECONDARY=
OPENROUTER_MODEL=xingchen-agi/xing4.0-29b-a4b:free
OPENROUTER_MODEL_SECONDARY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
QUANTAAI_AUTO_PROVIDER=teacher
QUANTAAI_QUANTALM_VERSION=v1
QUANTAAI_V2_CHECKPOINT=
TAVILY_API_KEY=

# Optional YouTube Data API v3 access for Study Agent video recommendations.
YOUTUBE_API_KEY=